{
  "name": "cinema-booking",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "cleanup": "tsx scripts/cleanup.ts",
    "migrate:make": "NODE_OPTIONS=\"--import tsx\" knex migrate:make --knexfile knexfile.ts",
    "migrate:latest": "NODE_OPTIONS=\"--import tsx\" knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "NODE_OPTIONS=\"--import tsx\" knex migrate:rollback --knexfile knexfile.ts",
    "migrate:status": "NODE_OPTIONS=\"--import tsx\" knex migrate:status --knexfile knexfile.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.2.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "knex": "^3.2.10",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  }
}
